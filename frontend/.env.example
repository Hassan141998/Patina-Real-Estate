# Copy to .env.local for local overrides, or set in your Vercel project
# settings under Environment Variables.
#
# Leave unset for local dev — Vite's proxy (vite.config.js) forwards /api
# and /uploads to Flask on localhost:5000 automatically.
#
# Set this once your backend is deployed (e.g. to Render), so the deployed
# frontend knows where to send API requests:
VITE_API_URL=https://your-backend.onrender.com
