# Copy to .env and adjust for local/production use.
JWT_SECRET_KEY=change-me-to-a-random-string

# Leave DATABASE_URL unset for local dev — app.py then defaults to the
# correct absolute path (backend/patina.db), which is what seed.py and
# fetch_photos.py also expect. Only set this for production deployments,
# and only with an ABSOLUTE path or a non-SQLite URL (e.g. Postgres) —
# a relative sqlite:///patina.db value resolves against whatever your
# terminal's current working directory happens to be, which can silently
# point different scripts at different database files.
# DATABASE_URL=postgresql://user:pass@host:5432/patina

# Optional: for backend/fetch_photos.py — get a free key at
# https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional: enables GET/POST /api/admin/seed, a way to seed the database on
# hosts (like Render's free tier) that don't offer Shell/SSH access for
# running scripts. Set to any random string, then visit:
# https://your-backend-url/api/admin/seed?key=THIS_VALUE
SEED_KEY=
